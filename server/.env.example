# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Cloud Connection URL
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/civiclens?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=civiclens_super_secret_jwt_key_2026_sih
JWT_EXPIRE=7d

# Google SMTP (Nodemailer) for OTP emails
# Use Google App Password from: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary Credentials (for Complaint Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Master Key for Super Admin First-Time Setup
SUPERADMIN_SECRET_KEY=CIVICLENS_SUPER_ADMIN_MASTER_KEY_2026
